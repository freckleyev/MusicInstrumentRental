<!DOCTYPE html>
<html data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Music Instruments Rental{% endblock %}</title>

        <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
        >
    </head>

    <body>
        <div class="container py-5 my-5">
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="card border-0 shadow-lg text-center overflow-hidden rounded-4">
                        <div class="bg-danger py-2"></div>
                        <div class="card-body p-4 p-md-5">
                            
                            <div class="d-inline-flex align-items-center justify-content-center text-danger rounded-circle mb-4" style="width: 80px; height: 80px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-ban" viewBox="0 0 16 16">
                                <path d="M15 8a6.97 6.97 0 0 0-1.71-4.584l-9.874 9.875A7 7 0 0 0 15 8M2.71 12.584l9.874-9.875a7 7 0 0 0-9.874 9.874ZM16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0"/>
                                </svg>
                            </div>
                            
                            <p class="text-muted fs-6 mb-4">
                                Your account has been blocked.<br>You currently do not have access to application services.
                            </p>

                            <div class="alert alert-light border border-secondary-subtle rounded-3 text-start mb-4">
                                <p class="mb-0 small text-muted">
                                    If you believe this is a mistake, please reach out to support at 
                                    <a href="mailto:spiderman@mail.com" class="text-decoration-none fw-semibold">spiderman@mail.com</a>.
                                </p>
                            </div>

                            <div class="d-grid gap-2">
                                <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-lg rounded-3 fw-semibold">
                                    <i class="bi bi-box-arrow-right me-1"></i> Log Out
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>


