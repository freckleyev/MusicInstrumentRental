{% extends 'base.html.twig' %}

{% block title %}
    My Rentals
{% endblock %}

{% block body %}

    <div class="container">
        <div class="text-center mb-4">
            <h1>
                My Rentals
            </h1>
            <p class="text-muted">
                View your rental requests and their current status.
            </p>
        </div>


        {% if rentalRequests is empty %}
            <div class="alert alert-info text-center">
                You have no rental requests yet.
                <div class="mt-3">
                    <a href="{{ path('app_public') }}" class="btn btn-outline-light">Browse Instruments</a>
                </div>
            </div>
        {% else %}
            <div class="row" data-masonry='{"percentPosition": true}'>
                {% for rental in rentalRequests %}
                    <div class="col-12 col-md-6 col-lg-4 mb-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h4 class="card-title text-center mb-1">
                                    {{ rental.instrument.name }}
                                </h4>
                                <hr class="my-2">
                                <p class="card-text mb-1"><strong>Rental period: </strong>{{ rental.startDate|date('d.m.Y') }} - {{ rental.endDate|date('d.m.Y') }}</p>
                                <p class="card-text mb-1"><strong>Purpose: </strong>{{ rental.purpose }}</p>
                                <hr class="my-2">
                                <p class="card-text mb-1"><strong>Request created: </strong>{{ rental.createdAt ? rental.createdAt|date('d.m.Y') : '' }}</p>
                                <p class="card-text mb-1"><strong>Request updated: </strong>{{ rental.updatedAt ? rental.updatedAt|date('d.m.Y') : '' }}</p>
                                <hr class="my-2">
                                
                                <strong>Status:</strong>
                                {% if rental.status.value == 'pending' %}
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    <form method="post" action="{{ path('app_my_rental_cancel', {'id': rental.id}) }}" class="text-end">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ rental.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm mt-1">Cancel Request</button>
                                    </form>
                                {% elseif rental.status.value == 'approved' %}
                                    <span class="badge bg-success">Approved</span>
                                {% elseif rental.status.value == 'rejected' %}
                                    <span class="badge bg-danger">Rejected</span>
                                    <p class="card-text mt-2 text-danger"><strong>Rejection reason : </strong>{{ rental.rejectionReason }}</p>
                                {% elseif rental.status.value == 'completed' %}
                                    <span class="badge bg-info">Completed</span>
                                {% elseif rental.status.value == 'canceled' %}
                                    <span class="badge bg-secondary">Canceled</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

{% endblock %}