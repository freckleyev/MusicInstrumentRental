{% extends 'base.html.twig' %}

{% block title %}
    My Rentals
{% endblock %}

{% block body %}

    <div class="container">

        <div class="text-center mb-4">

            <h1>
                My Rentals
            </h1>

            <p class="text-muted">
                View your rental requests and their current status.
            </p>

        </div>


        {% if rentalRequests is empty %}

            <div class="alert alert-info text-center">

                You have no rental requests yet.

                <div class="mt-3">

                    <a
                    href="{{ path('app_public') }}"
                    class="btn btn-primary"
                    >
                    Browse Instruments
                </a>

            </div>

        </div>

    {% else %}

        <div class="row g-4">

            {% for rental in rentalRequests %}

                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                {{ rental.instrument.name }}
                            </h5>

                            <p class="card-text mb-2">

                                <strong>
                                    Start date:
                                </strong>

                                {{ rental.startDate|date('d/m/Y') }}

                            </p>

                            <p class="card-text mb-2">

                                <strong>
                                    End date:
                                </strong>

                                {{ rental.endDate|date('d/m/Y') }}

                            </p>

                            <p class="card-text mb-3">

                                <strong>
                                    Purpose:
                                </strong>

                                {{ rental.purpose }}

                            </p>


                            <strong>
                                Status:
                            </strong>

                            {% if rental.status.value == 'pending' %}

                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>

                                <form
                                method="post"
                                action="{{ path('app_my_rental_cancel', {'id': rental.id}) }}"
                                class="mt-3"
                                >

                                <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('cancel' ~ rental.id) }}"
                                >

                                <button
                                type="submit"
                                class="btn btn-outline-danger btn-sm"
                                >
                                Cancel Request
                            </button>

                        </form>

                    {% elseif rental.status.value == 'approved' %}

                        <span class="badge bg-success">
                            Approved
                        </span>

                    {% elseif rental.status.value == 'rejected' %}

                        <span class="badge bg-danger">
                            Rejected
                        </span>

                    {% elseif rental.status.value == 'completed' %}

                        <span class="badge bg-primary">
                            Completed
                        </span>

                    {% elseif rental.status.value == 'canceled' %}

                        <span class="badge bg-secondary">
                            Canceled
                        </span>

                    {% endif %}

                </div>

            </div>

            </div>

        {% endfor %}

        </div>

    {% endif %}

    </div>

{% endblock %}