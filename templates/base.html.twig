<!DOCTYPE html>
<html data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Music Instruments Rental{% endblock %}</title>

        <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
        >
        <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
    </head>

    <body>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 mt-2">

            <div class="container">

                <a class="navbar-brand py-0" href="{{ path('app_public') }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 340 60" width="260" height="60">
                        <style>
                        .text-main { font-family: 'Segoe UI', system-ui, sans-serif; font-weight: 800; font-size: 28px; fill: #ffffff; }
                        .text-accent { font-family: 'Segoe UI', system-ui, sans-serif; font-weight: 800; font-size: 22px; fill: #0d6efd; }
                        </style>
                        
                        <!-- Left text: INSTRU -->
                        <text x="0" y="38" class="text-main">INSTRU</text>
                        
                        <!-- Shifted M (50% up) -->
                        <text x="112" y="22" class="text-main">M</text>
                        
                        <!-- R directly underneath M -->
                        <text x="114" y="48" class="text-main">R</text>
                        
                        <!-- Right text: ENTAL -->
                        <text x="142" y="38" class="text-main">ENTAL</text>
                    </svg>
                </a>

            <button
                class="navbar-toggler p-2 border-2 rounded-3 fs-3"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarContent"
                aria-controls="navbarContent"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon" style="width: 1.5em; height: 1.5em;"></span>
            </button>

        <div class="collapse navbar-collapse navbar-fullscreen mt-3 mt-lg-0" id="navbarContent">

        {# Navigation links #}
        <ul class="navbar-nav me-auto">

            {# Visible to everyone #}
            <li class="nav-item">
                    <a
                    class="nav-link 
                    {% if app.request.attributes.get('_route') == 'app_public' %}
                        text-white
                    {% endif %}
                    "
                    href="{{ path('app_public') }}"
                    >
                    Instruments
                </a>
            </li>

        {# Visible to logged-in users #}
        {% if is_granted('ROLE_USER') %}

            <li class="nav-item">
                <a
                class="nav-link
                {% if app.request.attributes.get('_route') == 'app_my_rentals' %}
                    text-white
                {% endif %}
                "
                href="{{ path('app_my_rentals') }}"
                >
                My Rentals
            </a>
        </li>

    {% endif %}

    {# Visible only to admins #}
    {% if is_granted('ROLE_ADMIN') %}

        <li class="nav-item">
            <a
                class="nav-link
                {% if app.request.pathInfo starts with '/dashboard' %}
                    text-white
                {% endif %}
                "
                href="{{ path('app_dashboard') }}"
                >
                Dashboard
            </a>
        </li>

{% endif %}

</ul>

{# Authentication buttons #}
<div class="d-flex gap-4">

    {% if app.user %}

        <a
        href="{{ path('app_profile') }}"
        title="My Profile"
        class="d-flex align-items-center"
        >
        {% if app.user.image %}
            <img
            src="{{ asset('images/users/' ~ app.user.image) }}"
            alt="Profile"
            class="rounded-circle"
            style="width: 40px; height: 40px; object-fit: cover;"
            >
        {% else %}
            <img
            src="{{ asset('images/users/image_placeholder.png') }}"
            alt="Profile"
            class="rounded-circle"
            style="width: 40px; height: 40px; object-fit: cover;"
            >
        {% endif %}
    </a>

    <a
    href="{{ path('app_logout') }}"
    class="btn btn-outline-light"
    >
    Logout
    </a>

{% else %}

    <a
    href="{{ path('app_login') }}"
    class="btn btn-outline-light"
    >
    Login
    </a>

    <a
    href="{{ path('app_register') }}"
    class="btn btn-primary"
    >
    Register
    </a>

{% endif %}

</div>

</div>

</div>

</nav>

<div class="container-fluid container-md my-2 my-md-5 p-0 px-sm-3">
    {% block body %}
    {% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" async></script>

</body>
</html>