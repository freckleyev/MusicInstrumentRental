<!DOCTYPE html>
<html data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Music Instruments Rental{% endblock %}</title>

        <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
        >
    </head>

    <body>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">

            <div class="container">

                <a
                class="navbar-brand"
                href="{{ path('app_public') }}"
                >
                Music Instrument Rental
            </a>

            <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarContent"
            aria-controls="navbarContent"
            aria-expanded="false"
            aria-label="Toggle navigation"
            >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div
        class="collapse navbar-collapse"
        id="navbarContent"
        >

        {# Navigation links #}
        <ul class="navbar-nav me-auto">

            {# Visible to everyone #}
            <li class="nav-item">
                <a
                class="nav-link
                {% if app.request.attributes.get('_route') == 'app_public' %}
                    text-white
                {% endif %}
                "
                href="{{ path('app_public') }}"
                >
                Instruments
            </a>
        </li>

        {# Visible to logged-in users #}
        {% if is_granted('ROLE_USER') %}

            <li class="nav-item">
                <a
                class="nav-link
                {% if app.request.attributes.get('_route') == 'app_my_rentals' %}
                    text-white
                {% endif %}
                "
                href="{{ path('app_my_rentals') }}"
                >
                My Rentals
            </a>
        </li>

    {% endif %}

    {# Visible only to admins #}
    {% if is_granted('ROLE_ADMIN') %}

        <li class="nav-item">
            <a
            class="nav-link
            {% if app.request.attributes.get('_route') starts with 'dashboard' %}
                text-white
            {% endif %}
            "
            href="{{ path('app_dashboard') }}"
            >
            Dashboard
        </a>
    </li>

{% endif %}

</ul>

{# Authentication buttons #}
<div class="d-flex gap-2">

    {% if app.user %}

        <a
        href="{{ path('app_profile') }}"
        title="My Profile"
        class="d-flex align-items-center"
        >
        {% if app.user.image %}
            <img
            src="{{ asset('images/users/' ~ app.user.image) }}"
            alt="Profile"
            class="rounded-circle"
            style="width: 40px; height: 40px; object-fit: cover;"
            >
        {% else %}
            <img
            src="{{ asset('images/users/image_placeholder.png') }}"
            alt="Profile"
            class="rounded-circle"
            style="width: 40px; height: 40px; object-fit: cover;"
            >
        {% endif %}
    </a>

    <a
    href="{{ path('app_logout') }}"
    class="btn btn-outline-light"
    >
    Logout
    </a>

{% else %}

    <a
    href="{{ path('app_login') }}"
    class="btn btn-outline-light"
    >
    Login
    </a>

    <a
    href="{{ path('app_register') }}"
    class="btn btn-primary"
    >
    Register
    </a>

{% endif %}

</div>

</div>

</div>

</nav>

<div class="container my-5">
    {% block body %}
    {% endblock %}
</div>

<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiq7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
crossorigin="anonymous"
></script>

</body>
</html>