{% extends 'base.html.twig' %}

{% block title %}
    Rental Request Submitted
{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-6">

                <div class="alert alert-success text-center">

                    <h1 class="h3">
                        Rental Request Submitted!
                    </h1>

                    <p class="mb-3">
                        Your rental request has been submitted successfully.
                    </p>

                    <p class="mb-4">
                        You can check the status of your request from your rentals page.
                    </p>

                    <a href="{{ path('app_public') }}" class="btn btn-outline-light mx-2">Back to Instruments</a>
                    <a href="{{ path('app_my_rentals') }}" class="btn btn-outline-light mx-2">My Rentals</a>

            </div>

        </div>

    </div>

    </div>

{% endblock %}