{% extends 'dashboard/dashboard.html.twig' %}

{% block title %}Instruments{% endblock %}

{% block dashboard_stats %}
{% endblock %}

{% block dashboard_body %}
    <h1>Instrument details</h1>

    <div class="row align-items-start">
        <div class="col-md-7">
            <table class="table table-hover">
                <tbody>
                    <tr>
                        <th style="width: 30%;">ID</th>
                        <td>{{ instrument.id }}</td>
                    </tr>
                    <tr>
                        <th>Instrument Name</th>
                        <td>{{ instrument.name }}</td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td>{{ instrument.category.name }}</td>
                    </tr>
                    <tr>
                        <th>Instrument Condition</th>
                        <td>{{ instrument.instrumentCondition }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ instrument.description }}</td>
                    </tr>
                    <tr>
                        <th>Daily Rental Price</th>
                        <td>{{ instrument.dailyRentalPrice }}€</td>
                    </tr>
                    <tr>
                        <th>Available</th>
                        <td>{{ instrument.isActive ? 'Yes' : 'No' }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-md-5 text-center">
            <br>
            <img src="{{ asset('images/instruments/' ~ instrument.image) }}" class="img-fluid rounded" style="max-width: 100%; max-height: 280px; object-fit: cover;" alt="{{ asset('images/instruments/' ~ instrument.image) }}"> 
        </div>
    </div>
    <div class="d-flex gap-1">
        <a href="{{ path('app_instruments_index') }}" class="btn btn-secondary">Back</a>
        <a href="{{ path('app_instruments_edit', {'id': instrument.id}) }}" class="btn btn-warning">Edit</a>
        {{ include('dashboard/instruments/_delete_form.html.twig') }}
    </div>
{% endblock %}
