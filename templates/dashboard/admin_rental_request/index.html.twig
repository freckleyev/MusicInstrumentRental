{% extends 'dashboard/dashboard.html.twig' %}

{% block title %}AdminRentalRequest{% endblock %}

{% block dashboard_stats %}{% endblock %}

{% block dashboard_body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mt-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <table class="table table-hover">
        <thead>
            <tr>
                <th style="width: 1%">ID</th>
                <th style="width: 12%">Instrument</th>
                <th>Start date</th>
                <th>End Date</th>
                <th>Total Price</th>
                <th>User</th>
                <th>Email</th>
                <th>Created</th>
                <th>Updated</th>
                <th style="width: 10%">Reviewed by</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for request in rental_requests %}
            <tr>
                <td>{{ request.id }} </td>
                <td>{{ request.instrument.name }}</td>
                <td>{{ request.startDate ? request.startDate|date('d.m.Y') : '' }}</td>

                {# IF NOT RETURNED ON TIME DATE IS RED #}
                {% if request.status.value == 'approved' and request.endDate < date() %}
                    <td class="text text-danger">
                        {{ request.endDate ? request.endDate|date('d.m.Y') : '' }}
                    </td>
                {% else %}
                    <td>
                        {{ request.endDate ? request.endDate|date('d.m.Y') : '' }}
                    </td>
                {% endif %}
                <td>€{{ request.totalPrice|number_format(2) }}</td>
                <td>{{ request.user.firstName}} {{ request.user.lastName}}</td>

                {# BLOCKED USER EMAIL IS RED #}
                {% if request.user.isBlocked %}
                    <td class="text text-danger">{{ request.user.email}}</td>
                {% else %}
                    <td>{{ request.user.email}}</td>
                {% endif %}
                
                <td>{{ request.createdAt ? request.createdAt|date('d.m.Y') : ''}}</td>
                <td>{{ request.updatedAt ? request.updatedAt|date('d.m.Y') : ''}}</td>
                <td>{{ request.reviewedBy ? request.reviewedBy.firstName : ''}} {{ request.reviewedBy ? request.reviewedBy.lastName : '' }}</td>
                <td>
                    {# DIFFERENT COLOR FOR DIFFERENT STATUS #}
                    <span class="{{ request.status.colorClass }}">
                        {{ request.status.value }}
                    </span>
                </td>

                {# ACTIONS #}
                <td>
                   <a href="{{ path('app_admin_rental_request_status_update', {id: request.id}) }}" class="btn btn-secondary">Manage</a>
                </td>
                
            </tr>
        {% else %}
            <tr>
                <td colspan="8">No rental requests found...</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
