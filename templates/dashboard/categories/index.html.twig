{% extends 'dashboard/dashboard.html.twig' %}

{% block title %}Categories index{% endblock %}

{% block dashboard_stats %}
{% endblock %}

{% block dashboard_body %}
    <div class='container my-3'>
        <a href="{{ path('app_categories_new') }}" class="btn btn-success">Add new category</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th style="width: 2%;">ID</th>
                <th>Name</th>
                <th style="width: 15%;">show | edit | del</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('app_categories_show', {'id': category.id}) }}" class="btn btn-secondary">☰</a>
                        <a href="{{ path('app_categories_edit', {'id': category.id}) }}" class="btn btn-warning">✎</a>
                        {{ include('dashboard/categories/_delete_form.html.twig', {'button_text': '✘'}) }}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
