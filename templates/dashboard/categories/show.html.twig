{% extends 'dashboard/dashboard.html.twig' %}

{% block title %}Categories{% endblock %}

{% block dashboard_stats %}
{% endblock %}

{% block dashboard_body %}
    <h1>Category details</h1>

    <div class="col-md-4">
        <table class="table">
            <tbody>
                <tr>
                    <th style="width: 25%;">ID</th>
                    <td>{{ category.id }}</td>
                </tr>
                <tr>
                    <th>Name</th>
                    <td>{{ category.name }}</td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <div class="d-flex gap-1">
        <a href="{{ path('app_categories_index') }}" class="btn btn-secondary">Back</a>
        <a href="{{ path('app_categories_edit', {'id': category.id}) }}" class="btn btn-warning">Edit</a>
        {{ include('dashboard/categories/_delete_form.html.twig') }}
    </div>
{% endblock %}
